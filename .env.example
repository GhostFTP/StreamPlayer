# Used by docker-compose.yml / Dokploy. Copy to .env and fill in.
# MEDIA_ROOT is set inside docker-compose.yml (always /media in-container) —
# point MEDIA_PATH below at the real folder on the host instead.
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=https://your-public-url
NODE_ENV=production
TMDB_API_KEY=your_tmdb_api_key_here

# Host-side path to your media library (bind-mounted into the container as /media)
MEDIA_PATH=/home/ghost/StreamPlayer/media
